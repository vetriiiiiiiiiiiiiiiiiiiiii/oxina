# ---- Database ----
# Local dev (npm run db:local) uses port 5433. On the VPS point this at the local PostgreSQL 17 server (port 5432).
DATABASE_URL="postgresql://oxina:CHANGE_ME@localhost:5433/oxina?schema=public"

# ---- Application ----
APP_URL="http://localhost:3000"
NODE_ENV="development"
# Set "true" ONLY in a development environment to allow fictional demo seed data.
ALLOW_DEMO_SEED="false"

# ---- Secrets (generate with: openssl rand -base64 48) ----
# Signs short-lived file download links.
FILE_SIGNING_SECRET="CHANGE_ME"
# 32-byte base64 key used for AES-256-GCM encryption of sensitive identifiers.
DATA_ENCRYPTION_KEY="CHANGE_ME_BASE64_32_BYTES"

# ---- Initial Super Admin bootstrap (deployment environment only; remove after first run) ----
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="Group Administrator"

# ---- File storage: "local" or "s3" ----
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./uploads"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# ---- Email (optional). Without SMTP_HOST, email deliveries are recorded as SKIPPED_NO_PROVIDER. ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Oxina Groups <no-reply@example.com>"

# ---- Optional providers (not implemented in this release; deliveries are SKIPPED_NO_PROVIDER) ----
SMS_PROVIDER=""
WHATSAPP_PROVIDER=""
