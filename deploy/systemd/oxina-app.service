# /etc/systemd/system/oxina-app.service
[Unit]
Description=Oxina Groups web application (Next.js)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=oxina
Group=oxina
WorkingDirectory=/opt/oxina/current
EnvironmentFile=/opt/oxina/shared/.env
Environment=NODE_ENV=production PORT=3000 HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/oxina/shared/uploads /opt/oxina/current/.next/cache

[Install]
WantedBy=multi-user.target
